{
  "name": "dechatter",
  "version": "0.2.0",
  "description": "CNCjs custom widget that finds chatter-free milling speeds, widths and depths from test cuts heard through the microphone.",
  "keywords": [
    "cncjs",
    "cnc",
    "chatter",
    "milling",
    "stability-lobes",
    "grbl",
    "widget"
  ],
  "license": "MIT",
  "author": "Pedro Paulo Vezza Campos <pedro@vezza.com.br>",
  "homepage": "https://github.com/pedropaulovc/dechatter#readme",
  "bugs": {
    "url": "https://github.com/pedropaulovc/dechatter/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedropaulovc/dechatter.git"
  },
  "exports": {
    "./index.html": "./web/index.html",
    "./package.json": "./package.json"
  },
  "files": [
    "web",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node .github/build_widget.mjs",
    "prepare": "npm run build"
  }
}
